# Server
PORT=8080
DB_PATH=data/lineage.db
OWNER_SECRET=change-me

# PayPal (sandbox only; the host is pinned in code)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret

# Sandbox account emails used by the demo seed data
VENDOR_A_EMAIL=vendor-a@personal.example.com
VENDOR_B_EMAIL=vendor-b@personal.example.com
ATTACKER_EMAIL=attacker@personal.example.com

# LLM (optional; scripted and compromised modes need no key)
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=

# Guard policy
PER_TX_CAP_CENTS=500000
DAILY_CAP_CENTS=1500000
PO_TOLERANCE_BPS=0
ALLOWED_CURRENCIES=USD

# NEAR Intents rail (used by adapters/near)
ALLOWED_ASSETS=nep141:usdc.test
MAX_INTENT_TTL_SECONDS=300
# Leave INTENTS_SALT empty to read the Verifier's current salt over NEAR_RPC_URL on every request.
INTENTS_SALT=
NEAR_RPC_URL=https://rpc.mainnet.near.org
INTENTS_VERIFIER=intents.near
